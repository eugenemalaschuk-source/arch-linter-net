    "baselineGroupsV3": {
      "$ref": "#/$defs/baselineGroupsV2",
      "description": "Version-3 finding baseline groups retain the structured version-2 entry shape."
    },
    "metricBaselineCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metricBaselineEntry"
      },
      "description": "Reviewed scalar metric values for version-3 baselines."
    },
    "metricBaselineEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_identity_version",
        "metric_id",
        "metric_kind",
        "native_subject",
        "effective_scope",
        "value"
      ],
      "properties": {
        "metric_identity_version": {
          "type": "integer",
          "const": 1,
          "description": "Canonical metric identity schema version."
        },
        "metric_id": {
          "type": "string",
          "minLength": 1,
          "description": "The declared metric ID; metric baseline IDs must be unique within a document."
        },
        "metric_kind": {
          "type": "string",
          "enum": [
            "outgoing_component_count",
            "incoming_component_count",
            "external_dependency_group_count",
            "component_footprint_count",
            "topology_type_count",
            "public_contract_surface_count"
          ],
          "description": "Canonical metric kind from the metric definition."
        },
        "native_subject": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical native subject selected by the metric definition."
        },
        "unit": {
          "type": "string",
          "enum": [
            "project",
            "assembly"
          ],
          "description": "Optional metric unit, present when the metric definition declares one."
        },
        "effective_scope": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical effective scope reported for the metric measurement."
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "description": "Reviewed non-negative scalar metric value."
        }
      }
    },
    "baselineContractEntryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ignored_violations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Contract ID matching the id field in an architecture contract."
        },
        "ignored_violations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/baselineViolationV1"
          },
          "minItems": 1,
          "description": "Violation entries to suppress for this contract."
        }
      }
    },
