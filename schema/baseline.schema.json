{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archlinternet.dev/schema/0.5.1/baseline.schema.json",
  "title": "ArchLinterNet baseline file",
  "description": "Schema for baseline YAML files that suppress known violations for architecture policy migration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "baseline"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ],
      "description": "Baseline file format version. Version 1 uses the legacy exact (source_type, forbidden_reference) pair as identity, and its ignored_violations entries MUST NOT carry structured identity fields. Versions 2 and 3 use a versioned, structured ArchitectureViolationIdentity per finding entry, and every finding entry MUST carry identity_version, contract_family, kind, and occurrence. Version 3 additionally permits the separate metric_baselines collection."
    },
    "baseline": {
      "type": "object",
      "description": "Contract group entries indexed by contract group name. The exact shape required for each entry depends on the top-level 'version' (see the version-conditional definitions below)."
    },
    "metric_baselines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metricBaselineEntry"
      },
      "description": "Reviewed scalar metric values. This collection is valid only in a version-3 document and is never interpreted as finding-level ignored violations."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "baseline": {
            "$ref": "#/$defs/baselineGroupsV1"
          }
        },
        "not": {
          "required": [
            "metric_baselines"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "baseline": {
            "$ref": "#/$defs/baselineGroupsV2"
          }
        },
        "not": {
          "required": [
            "metric_baselines"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "const": 3
          }
        }
      },
      "then": {
        "properties": {
          "baseline": {
            "$ref": "#/$defs/baselineGroupsV3"
          },
          "metric_baselines": {
            "$ref": "#/$defs/metricBaselineCollection"
          }
        }
      }
    }
  ],
