    { "logicalId": "policy-root", "documentVersion": "v1", "resourcePath": "schema/0.6.1/dependencies.arch.schema.json", "resourceName": "ArchLinterNet.Core.Schema.0.6.1.dependencies.arch.schema.json", "schemaId": "https://archlinternet.dev/schema/0.6.1/dependencies.arch.schema.json", "sha256": "9f01d46deb5aa17c4231d0c7bfa41a3409c5a358710bd1881201f310bfc55914", "supportsRead": true, "supportsWrite": true, "migrationNote": "Policy version 1 is supported. Schema identity advanced to 0.6.1 to add layers.*.overlaps_with; the 0.5.1 policy-root schema (schema/0.5.1/dependencies.arch.schema.json) remains byte-for-byte frozen and does not accept overlaps_with.", "owningCapability": "policy-document-validation-pipeline" },
