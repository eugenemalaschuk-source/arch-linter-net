  "schemas": [
    { "logicalId": "policy-root", "documentVersion": "v1", "resourcePath": "schema/0.8.0/dependencies.arch.schema.json", "resourceName": "ArchLinterNet.Core.Schema.0.8.0.dependencies.arch.schema.json", "schemaId": "https://archlinternet.dev/schema/0.8.0/dependencies.arch.schema.json", "sha256": "cdb98508818d87c679d36264d0efb503731ce18a6e7001dac2080adc45573376", "supportsRead": true, "supportsWrite": true, "migrationNote": "Policy version 1 is supported. Schema identity advanced to 0.8.0 for external_evidence, topology, metric definitions, and absolute and baseline-relative metric budget contracts; the 0.6.1 policy-root schema remains byte-for-byte frozen and does not declare these fields.", "owningCapability": "policy-document-validation-pipeline" },
    { "logicalId": "policy-fragment", "documentVersion": "v1", "resourcePath": "schema/0.8.0/dependencies.arch.fragment.schema.json", "resourceName": "ArchLinterNet.Core.Schema.0.8.0.dependencies.arch.fragment.schema.json", "schemaId": "https://archlinternet.dev/schema/0.8.0/dependencies.arch.fragment.schema.json", "sha256": "0de2bf7341e9cfcd665fad78a8ca58046917f23f556b79e30b89a2b919d17972", "supportsRead": true, "supportsWrite": true, "migrationNote": "Imported fragments remain version 1. Advanced alongside policy-root to 0.8.0 so external_evidence, topology, and metric definitions resolve against the paired policy-root $defs.", "owningCapability": "policy-document-validation-pipeline" },
    { "logicalId": "baseline", "documentVersion": "v3", "resourcePath": "schema/0.5.1/baseline.schema.json", "resourceName": "ArchLinterNet.Core.Schema.baseline.schema.json", "schemaId": "https://archlinternet.dev/schema/0.5.1/baseline.schema.json", "sha256": "dc8b1359d27b8c8ecc0ac63f84628411a3a030de2cea0aeb7c316943565451e9", "supportsRead": true, "supportsWrite": true, "migrationNote": "Baseline versions 1 and 2 remain readable; version 3 retains structured finding identities and adds a separate reviewed metric_baselines collection for relative metric budgets.", "owningCapability": "baseline-generation" },
    { "logicalId": "api-snapshot", "documentVersion": "v1", "resourcePath": "schema/0.5.1/api-snapshot.schema.json", "schemaId": "https://archlinternet.dev/schema/0.5.1/api-snapshot.schema.json", "sha256": "6fe7015c5bc1d6c57333f01abcdfdcf97f99e8bd9c522d3ee0932d884758f21b", "supportsRead": true, "supportsWrite": true, "migrationNote": "Line-oriented public API snapshot format v1 with a canonical-model contract.", "owningCapability": "public-api-snapshots" },
    { "logicalId": "normalized-finding", "documentVersion": "v3", "resourcePath": "schema/0.8.0/normalized-finding.schema.json", "resourceName": "ArchLinterNet.Core.Schema.0.8.0.normalized-finding.schema.json", "schemaId": "https://archlinternet.dev/schema/0.8.0/normalized-finding.schema.json", "sha256": "5f3196e12cf0e4a8654163a981d5527de2ae8918b2d7de6a7e37b15da85cae56", "supportsRead": true, "supportsWrite": true, "migrationNote": "JSON v3 adds imported external diagnostics and metric-budget threshold findings with typed absolute and baseline-relative evidence; writers emit schema_version 3 and readers retain v1 and v2 support.", "owningCapability": "diagnostics-model" },
    { "logicalId": "analysis-build-state", "documentVersion": "v1", "resourcePath": "schema/0.5.1/analysis-build-state.schema.json", "schemaId": "https://archlinternet.dev/schema/0.5.1/analysis-build-state.schema.json", "sha256": "c07ab9ce232972f694e6a18ab65093d6c926344deee77281f75a21edd33dbd38", "supportsRead": true, "supportsWrite": true, "migrationNote": "Current BuildReceiptV1 format.", "owningCapability": "analysis-build-state-fingerprints" },
    { "logicalId": "analysis-cache", "documentVersion": "v1", "resourcePath": "schema/0.8.0/analysis-cache.schema.json", "resourceName": "ArchLinterNet.Core.Schema.0.8.0.analysis-cache.schema.json", "schemaId": "https://archlinternet.dev/schema/0.8.0/analysis-cache.schema.json", "sha256": "7161f472a0a9cf2f287d7cbc6ed55d96f7c7eacdeaca12de55ed941b0bfa8898", "supportsRead": true, "supportsWrite": true, "migrationNote": "Analysis-cache v1 adds MetricBudgetPayload to its explicit closed payload schema. The frozen 0.5.1 and 0.6.1 bytes remain packaged as legacy read contracts.", "owningCapability": "analysis-cache" },
    { "logicalId": "analysis-profile", "documentVersion": "v1", "resourcePath": "schema/0.5.1/analysis-profile.schema.json", "schemaId": "https://archlinternet.dev/schema/0.5.1/analysis-profile.schema.json", "sha256": "87e79b86d4aa3009f174cbe32ca66cc35975d399714a112d690bc69e86e58586", "supportsRead": false, "supportsWrite": true, "migrationNote": "Analysis-profile v1 is a generated-output format; a public document reader is not yet implemented.", "owningCapability": "analysis-profile" }
  ]
