  "schemas": [
    { "logicalId": "policy-root", "documentVersion": "v1", "resourcePath": "schema/0.8.0/dependencies.arch.schema.json", "resourceName": "ArchLinterNet.Core.Schema.0.8.0.dependencies.arch.schema.json", "schemaId": "https://archlinternet.dev/schema/0.8.0/dependencies.arch.schema.json", "sha256": "74a732826e9d1e4f4ff6fca41061a45e2603bdf8f92201304a058e982c12ad6a", "supportsRead": true, "supportsWrite": true, "migrationNote": "Policy version 1 is supported. Schema identity advanced to 0.8.0 for external_evidence, topology, metric definitions, metric budgets, and contract-surface exposure controls; the 0.6.1 policy-root schema remains byte-for-byte frozen and does not declare these fields.", "owningCapability": "policy-document-validation-pipeline" },
    { "logicalId": "policy-fragment", "documentVersion": "v1", "resourcePath": "schema/0.8.0/dependencies.arch.fragment.schema.json", "resourceName": "ArchLinterNet.Core.Schema.0.8.0.dependencies.arch.fragment.schema.json", "schemaId": "https://archlinternet.dev/schema/0.8.0/dependencies.arch.fragment.schema.json", "sha256": "0de2bf7341e9cfcd665fad78a8ca58046917f23f556b79e30b89a2b919d17972", "supportsRead": true, "supportsWrite": true, "migrationNote": "Imported fragments remain version 1. Advanced alongside policy-root to 0.8.0 so external_evidence, topology, and metric definitions resolve against the paired policy-root $defs.", "owningCapability": "policy-document-validation-pipeline" },
    { "logicalId": "baseline", "documentVersion": "v3", "resourcePath": "schema/0.8.0/baseline.schema.json", "resourceName": "ArchLinterNet.Core.Schema.0.8.0.baseline.schema.json", "schemaId": "https://archlinternet.dev/schema/0.8.0/baseline.schema.json", "sha256": "a2fe301065aa08cbc9eb1858665dc17fb5753093aba457dd41163be58975392d", "supportsRead": true, "supportsWrite": true, "migrationNote": "Baseline versions 1 and 2 remain readable through the frozen 0.5.1 contract; version 3 retains structured finding identities, metric_baselines, and contract-surface exposure baseline groups.", "owningCapability": "baseline-generation" },
    { "logicalId": "api-snapshot", "documentVersion": "v1", "resourcePath": "schema/0.5.1/api-snapshot.schema.json", "schemaId": "https://archlinternet.dev/schema/0.5.1/api-snapshot.schema.json", "sha256": "6fe7015c5bc1d6c57333f01abcdfdcf97f99e8bd9c522d3ee0932d884758f21b", "supportsRead": true, "supportsWrite": true, "migrationNote": "Line-oriented public API snapshot format v1 with a canonical-model contract.", "owningCapability": "public-api-snapshots" },
    { "logicalId": "normalized-finding", "documentVersion": "v3", "resourcePath": "schema/0.8.0/normalized-finding.schema.json", "resourceName": "ArchLinterNet.Core.Schema.0.8.0.normalized-finding.schema.json", "schemaId": "https://archlinternet.dev/schema/0.8.0/normalized-finding.schema.json", "sha256": "4dcb3375f165dc7a00b7d08cdf255190bba83b18fc70980694faac2eed74b32d", "supportsRead": true, "supportsWrite": true, "migrationNote": "JSON v3 includes imported external diagnostics, metric-budget threshold findings, and path-rich contract-surface exposure findings; writers emit schema_version 3 and readers retain v1 and v2 support.", "owningCapability": "diagnostics-model" },
    { "logicalId": "analysis-build-state", "documentVersion": "v1", "resourcePath": "schema/0.5.1/analysis-build-state.schema.json", "schemaId": "https://archlinternet.dev/schema/0.5.1/analysis-build-state.schema.json", "sha256": "c07ab9ce232972f694e6a18ab65093d6c926344deee77281f75a21edd33dbd38", "supportsRead": true, "supportsWrite": true, "migrationNote": "Current BuildReceiptV1 format.", "owningCapability": "analysis-build-state-fingerprints" },
    { "logicalId": "analysis-cache", "documentVersion": "v1", "resourcePath": "schema/0.8.0/analysis-cache.schema.json", "resourceName": "ArchLinterNet.Core.Schema.0.8.0.analysis-cache.schema.json", "schemaId": "https://archlinternet.dev/schema/0.8.0/analysis-cache.schema.json", "sha256": "84515473b56ca4cd1c29546f667887b02fe7884cfe1cf5875a01126b494fbc9e", "supportsRead": true, "supportsWrite": true, "migrationNote": "Analysis-cache v1 adds MetricBudgetPayload, ContractSurfaceExposurePayload, and optional effective-policy inventory evidence to its explicit writer schema. The frozen 0.5.1 and 0.6.1 bytes remain packaged as legacy read contracts.", "owningCapability": "analysis-cache" },
    { "logicalId": "analysis-profile", "documentVersion": "v1", "resourcePath": "schema/0.5.1/analysis-profile.schema.json", "schemaId": "https://archlinternet.dev/schema/0.5.1/analysis-profile.schema.json", "sha256": "87e79b86d4aa3009f174cbe32ca66cc35975d399714a112d690bc69e86e58586", "supportsRead": false, "supportsWrite": true, "migrationNote": "Analysis-profile v1 is a generated-output format; a public document reader is not yet implemented.", "owningCapability": "analysis-profile" }
