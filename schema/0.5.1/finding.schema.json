{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archlinternet.dev/schema/0.5.1/finding.schema.json",
  "title": "ArchLinterNet normalized finding v1",
  "type": "object",
  "required": ["version", "identity_version", "kind", "message"],
  "properties": {
    "version": { "const": 1 },
    "identity_version": { "const": 1 },
    "kind": { "type": "string", "minLength": 1 },
    "message": { "type": "string" },
    "details": { "type": "object" }
  },
  "additionalProperties": true
}
