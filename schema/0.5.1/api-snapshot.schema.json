{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archlinternet.dev/schema/0.5.1/api-snapshot.schema.json",
  "title": "ArchLinterNet API snapshot v1 canonical model",
  "description": "Validates the canonical model obtained by parsing a line-oriented public API snapshot. Use PackagedSchemaRegistry.TryValidateText to validate the serialized text against this contract.",
  "type": "object",
  "required": ["format", "version", "contract", "assemblies"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "arch-linter-net/public-api-snapshot" },
    "version": { "const": 1 },
    "contract": { "type": "string", "pattern": "^\\S+$" },
    "assemblies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "signatures"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "signatures": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    }
  },
  "contentMediaType": "text/plain",
  "x-archlinternet-text-format": {
    "formatIdentifier": "arch-linter-net/public-api-snapshot",
    "version": 1,
    "validationEntrypoint": "ArchLinterNet.Core.Schema.PackagedSchemaRegistry.TryValidateText",
    "serializedDocument": {
      "lineEnding": "LF",
      "trailingNewline": true,
      "prologue": [
        "# arch-linter-net public API snapshot — generated by 'arch-linter-net public-api capture'.",
        "# Review changes to this file like any other reviewed artifact; do not edit it by hand."
      ],
      "directives": [
        { "name": "@format", "value": "arch-linter-net/public-api-snapshot", "required": true, "unique": true },
        { "name": "@version", "value": "1", "required": true, "unique": true },
        { "name": "@contract", "value": "<non-whitespace contract id>", "required": true, "unique": true },
        { "name": "@assembly", "value": "<assembly name>", "required": false, "unique": false }
      ],
      "signatureLines": {
        "placement": "after an @assembly directive",
        "normalization": "one non-empty normalized signature per line",
        "ordering": "ordinal by assembly and then signature",
        "duplicates": "collapsed"
      }
    }
  }
}
