{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archlinternet.dev/schema/0.5.1/normalized-finding.schema.json",
  "title": "ArchLinterNet normalized finding v1",
  "type": "object",
  "required": ["schema_version", "kind", "canonical_identity", "mode", "severity", "message_code", "policy_origin", "source_location", "baseline_state", "details"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": {
      "type": "string",
      "enum": [
        "dependency", "cycle", "unmatched_ignore", "configuration", "external_dependency",
        "policy_consistency", "package_dependency", "type_placement", "public_api_surface",
        "attribute_usage", "inheritance", "interface_implementation", "composition",
        "project_metadata", "context_dependency", "context_allow_only", "port_boundary",
        "layout_convention", "package_allow_only", "framework_reference",
        "framework_reference_allow_only", "build_state_preflight", "baseline", "architecture_policy_error"
      ]
    },
    "contract": { "type": ["string", "null"] },
    "contract_id": { "type": ["string", "null"] },
    "canonical_identity": { "type": "string" },
    "mode": { "type": ["string", "null"] },
    "severity": { "type": ["string", "null"] },
    "message_code": { "type": "string" },
    "policy_origin": { "type": ["object", "null"] },
    "source_location": { "type": ["object", "null"], "properties": { "path": { "type": "string" } } },
    "baseline_state": { "type": ["string", "null"] },
    "source": { "type": "string" },
    "forbidden_namespace": { "type": "string" },
    "forbidden_references": { "type": "array", "items": { "type": "string" } },
    "details": {
      "type": "object",
      "required": ["detail_kind"],
      "oneOf": [
        { "properties": { "detail_kind": { "const": "dependency" } } },
        { "properties": { "detail_kind": { "const": "configuration" } } },
        { "properties": { "detail_kind": { "const": "external_dependency" } } },
        { "properties": { "detail_kind": { "const": "package_dependency" }, "forbidden_package_group": { "type": "string" } }, "required": ["forbidden_package_group"] },
        { "properties": { "detail_kind": { "const": "package_allow_only" } } },
        { "properties": { "detail_kind": { "const": "framework_reference" } } },
        { "properties": { "detail_kind": { "const": "framework_reference_allow_only" } } },
        { "properties": { "detail_kind": { "const": "type_placement" } } },
        { "properties": { "detail_kind": { "const": "layout_convention" } } },
        { "properties": { "detail_kind": { "const": "public_api_surface" } } },
        { "properties": { "detail_kind": { "const": "attribute_usage" } } },
        { "properties": { "detail_kind": { "const": "inheritance" } } },
        { "properties": { "detail_kind": { "const": "interface_implementation" } } },
        { "properties": { "detail_kind": { "const": "composition" } } },
        { "properties": { "detail_kind": { "const": "project_metadata" } } },
        { "properties": { "detail_kind": { "const": "context_dependency" } } },
        { "properties": { "detail_kind": { "const": "context_allow_only" } } },
        { "properties": { "detail_kind": { "const": "port_boundary" } } },
        { "properties": { "detail_kind": { "const": "cycle" }, "path": { "type": "string" } }, "required": ["path"] },
        { "properties": { "detail_kind": { "const": "unmatched_ignore" } } },
        { "properties": { "detail_kind": { "const": "policy_consistency" } } },
        { "properties": { "detail_kind": { "const": "build_state_preflight" } } },
        { "properties": { "detail_kind": { "const": "baseline" } } },
        { "properties": { "detail_kind": { "const": "architecture_policy_error" } } }
      ]
    }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "dependency" } } }, "then": { "properties": { "details": { "properties": { "detail_kind": { "const": "dependency" } } } } } },
    { "if": { "properties": { "kind": { "const": "cycle" } } }, "then": { "properties": { "details": { "properties": { "detail_kind": { "const": "cycle" } }, "required": ["path"] } } } },
    { "if": { "properties": { "kind": { "const": "unmatched_ignore" } } }, "then": { "properties": { "details": { "properties": { "detail_kind": { "const": "unmatched_ignore" } } } } } },
    { "if": { "properties": { "kind": { "const": "configuration" } } }, "then": { "properties": { "details": { "properties": { "detail_kind": { "const": "configuration" } } } } } },
    { "if": { "properties": { "kind": { "const": "external_dependency" } } }, "then": { "properties": { "details": { "properties": { "detail_kind": { "const": "external_dependency" } } } } } },
    { "if": { "properties": { "kind": { "const": "policy_consistency" } } }, "then": { "properties": { "details": { "properties": { "detail_kind": { "const": "policy_consistency" } } } } } },
    { "if": { "properties": { "kind": { "const": "package_dependency" } } }, "then": { "properties": { "details": { "properties": { "detail_kind": { "const": "package_dependency" } }, "required": ["forbidden_package_group"] } } } },
    { "if": { "properties": { "kind": { "const": "type_placement" } } }, "then": { "properties": { "details": { "properties": { "detail_kind": { "const": "type_placement" } } } } } },
    { "if": { "properties": { "kind": { "const": "public_api_surface" } } }, "then": { "properties": { "details": { "properties": { "detail_kind": { "const": "public_api_surface" } } } } } },
    { "if": { "properties": { "kind": { "const": "attribute_usage" } } }, "then": { "properties": { "details": { "properties": { "detail_kind": { "const": "attribute_usage" } } } } } },
    { "if": { "properties": { "kind": { "const": "inheritance" } } }, "then": { "properties": { "details": { "properties": { "detail_kind": { "const": "inheritance" } } } } } },
    { "if": { "properties": { "kind": { "const": "interface_implementation" } } }, "then": { "properties": { "details": { "properties": { "detail_kind": { "const": "interface_implementation" } } } } } },
    { "if": { "properties": { "kind": { "const": "composition" } } }, "then": { "properties": { "details": { "properties": { "detail_kind": { "const": "composition" } } } } } },
    { "if": { "properties": { "kind": { "const": "project_metadata" } } }, "then": { "properties": { "details": { "properties": { "detail_kind": { "const": "project_metadata" } } } } } },
    { "if": { "properties": { "kind": { "const": "context_dependency" } } }, "then": { "properties": { "details": { "properties": { "detail_kind": { "const": "context_dependency" } } } } } },
    { "if": { "properties": { "kind": { "const": "context_allow_only" } } }, "then": { "properties": { "details": { "properties": { "detail_kind": { "const": "context_allow_only" } } } } } },
    { "if": { "properties": { "kind": { "const": "port_boundary" } } }, "then": { "properties": { "details": { "properties": { "detail_kind": { "const": "port_boundary" } } } } } },
    { "if": { "properties": { "kind": { "const": "layout_convention" } } }, "then": { "properties": { "details": { "properties": { "detail_kind": { "const": "layout_convention" } } } } } },
    { "if": { "properties": { "kind": { "const": "package_allow_only" } } }, "then": { "properties": { "details": { "properties": { "detail_kind": { "const": "package_allow_only" } } } } } },
    { "if": { "properties": { "kind": { "const": "framework_reference" } } }, "then": { "properties": { "details": { "properties": { "detail_kind": { "const": "framework_reference" } } } } } },
    { "if": { "properties": { "kind": { "const": "framework_reference_allow_only" } } }, "then": { "properties": { "details": { "properties": { "detail_kind": { "const": "framework_reference_allow_only" } } } } } },
    { "if": { "properties": { "kind": { "const": "build_state_preflight" } } }, "then": { "properties": { "details": { "properties": { "detail_kind": { "const": "build_state_preflight" } }, "required": ["state", "project_path"] } } } },
    { "if": { "properties": { "kind": { "const": "baseline" } } }, "then": { "properties": { "details": { "properties": { "detail_kind": { "const": "baseline" } }, "required": ["contract_group", "source_type", "forbidden_reference"] } } } },
    { "if": { "properties": { "kind": { "const": "architecture_policy_error" } } }, "then": { "properties": { "details": { "properties": { "detail_kind": { "const": "architecture_policy_error" } } } } } }
  ],
  "additionalProperties": true
}
