root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cs,csx}]
indent_size = 4

[*.cs]
end_of_line = lf
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion

csharp_style_expression_bodied_methods = false:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_operators = false:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion
dotnet_style_readonly_field = true:warning

# Qodana Community .NET uses ReSharper InspectCode. Keep these reviewed, low-risk
# findings enabled and visible as suggestions instead of reporting them as High.
resharper_redundant_using_directive_highlighting=suggestion
resharper_redundant_name_qualifier_highlighting=suggestion
resharper_check_namespace_highlighting=suggestion
resharper_empty_constructor_highlighting=suggestion
resharper_redundant_argument_default_value_highlighting=suggestion
resharper_convert_type_check_pattern_to_null_check_highlighting=suggestion
resharper_redundant_suppress_nullable_warning_expression_highlighting=suggestion
resharper_redundant_cast_highlighting=suggestion
resharper_redundant_default_member_initializer_highlighting=suggestion
resharper_redundant_switch_expression_arms_highlighting=suggestion
resharper_redundant_enumerable_cast_call_highlighting=suggestion
resharper_redundant_empty_switch_section_highlighting=suggestion
resharper_redundant_nullable_directive_highlighting=suggestion
resharper_redundant_type_arguments_of_method_highlighting=suggestion
resharper_duplicated_statements_highlighting=suggestion
resharper_with_expression_modifies_all_members_highlighting=suggestion
resharper_partial_type_with_single_part_highlighting=suggestion
resharper_parameter_hides_member_highlighting=suggestion
resharper_parameter_hides_primary_constructor_parameter_highlighting=suggestion
resharper_variable_hides_outer_variable_highlighting=suggestion
resharper_unused_auto_property_accessor_global_highlighting=suggestion
resharper_not_accessed_positional_property_global_highlighting=suggestion
resharper_not_accessed_positional_property_local_highlighting=suggestion
resharper_unused_member_local_highlighting=suggestion
resharper_unused_auto_property_accessor_local_highlighting=suggestion
resharper_unused_type_parameter_highlighting=suggestion
resharper_unused_parameter_local_highlighting=suggestion
resharper_value_parameter_not_used_highlighting=suggestion
resharper_unused_variable_highlighting=suggestion
resharper_unused_tuple_component_in_return_value_highlighting=suggestion
resharper_unused_method_return_value_local_highlighting=suggestion
resharper_collection_never_updated_global_highlighting=suggestion
resharper_collection_never_updated_local_highlighting=suggestion
resharper_collection_never_queried_global_highlighting=suggestion
resharper_collection_never_queried_local_highlighting=suggestion
resharper_not_accessed_field_local_highlighting=suggestion
resharper_parameter_only_used_for_precondition_check_local_highlighting=suggestion
resharper_condition_is_always_true_or_false_according_to_nullable_api_contract_highlighting=suggestion
resharper_null_coalescing_condition_is_always_not_null_according_to_api_contract_highlighting=suggestion
resharper_conditional_access_qualifier_is_non_nullable_according_to_api_contract_highlighting=suggestion
resharper_constant_null_coalescing_condition_highlighting=suggestion
resharper_access_to_disposed_closure_highlighting=suggestion
resharper_access_to_modified_closure_highlighting=suggestion
resharper_variable_can_be_not_nullable_highlighting=suggestion
resharper_member_hides_static_from_outer_class_highlighting=suggestion

dotnet_naming_rule.private_instance_fields_should_be_underscore_camel_case.severity = warning
dotnet_naming_rule.private_instance_fields_should_be_underscore_camel_case.symbols = private_instance_fields
dotnet_naming_rule.private_instance_fields_should_be_underscore_camel_case.style = underscore_camel_case

dotnet_naming_rule.private_static_fields_should_be_underscore_camel_case.severity = warning
dotnet_naming_rule.private_static_fields_should_be_underscore_camel_case.symbols = private_static_fields
dotnet_naming_rule.private_static_fields_should_be_underscore_camel_case.style = underscore_camel_case

dotnet_naming_rule.constants_should_be_pascal_case.severity = warning
dotnet_naming_rule.constants_should_be_pascal_case.symbols = constants
dotnet_naming_rule.constants_should_be_pascal_case.style = pascal_case

dotnet_naming_rule.non_private_members_should_be_pascal_case.severity = warning
dotnet_naming_rule.non_private_members_should_be_pascal_case.symbols = non_private_members
dotnet_naming_rule.non_private_members_should_be_pascal_case.style = pascal_case

dotnet_naming_rule.types_should_be_pascal_case.severity = warning
dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case

dotnet_naming_rule.interfaces_should_be_prefixed_with_i.severity = warning
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.style = interface_prefix

dotnet_naming_rule.type_parameters_should_start_with_t.severity = suggestion
dotnet_naming_rule.type_parameters_should_start_with_t.symbols = type_parameters
dotnet_naming_rule.type_parameters_should_start_with_t.style = type_parameter_prefix

dotnet_naming_rule.locals_and_parameters_should_be_camel_case.severity = suggestion
dotnet_naming_rule.locals_and_parameters_should_be_camel_case.symbols = locals_and_parameters
dotnet_naming_rule.locals_and_parameters_should_be_camel_case.style = camel_case

dotnet_naming_symbols.private_instance_fields.applicable_kinds = field
dotnet_naming_symbols.private_instance_fields.applicable_accessibilities = private

dotnet_naming_symbols.private_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_fields.required_modifiers = static

dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_symbols.non_private_members.applicable_kinds = property, method, field, event
dotnet_naming_symbols.non_private_members.applicable_accessibilities = public, protected, internal, protected_internal, private_protected

dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum, delegate

dotnet_naming_symbols.interfaces.applicable_kinds = interface

dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter

dotnet_naming_symbols.locals_and_parameters.applicable_kinds = local, parameter

dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_style.interface_prefix.required_prefix = I
dotnet_naming_style.interface_prefix.capitalization = pascal_case

dotnet_naming_style.type_parameter_prefix.required_prefix = T
dotnet_naming_style.type_parameter_prefix.capitalization = pascal_case

[*.{sln,slnx,csproj,props,targets,xml,uxml,uss,xaml}]
indent_size = 2

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false
indent_size = 2

[*.{bat,cmd,ps1,sh}]
indent_size = 2

[*.{png,jpg,jpeg,gif,webp,ico,ttf,otf,woff,woff2,mp3,wav,ogg}]
insert_final_newline = unset
trim_trailing_whitespace = unset

[Makefile]
indent_style = tab
