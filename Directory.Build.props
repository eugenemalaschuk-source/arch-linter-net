<Project>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      Explicit next development release line. Main-build packaging reads this value and appends
      `-main.N`; the public release workflow remains tag/scenario driven and overrides Version.
      Advance this in a normal PR after a stable release instead of inferring minor/patch intent.
    -->
    <ArchLinterDevelopmentVersion>0.8.0</ArchLinterDevelopmentVersion>
    <VersionPrefix>$(ArchLinterDevelopmentVersion)</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
    <Authors>Eugene Malashchuk</Authors>
    <Company>Eugene Malashchuk</Company>
    <Copyright>Copyright (c) 2026 Eugene Malashchuk</Copyright>
    <PackageProjectUrl>https://eugenemalaschuk-source.github.io/arch-linter-net/</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>architecture;linting;dotnet;yaml;ci</PackageTags>
    <RepositoryUrl>https://github.com/eugenemalaschuk-source/arch-linter-net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
</Project>
