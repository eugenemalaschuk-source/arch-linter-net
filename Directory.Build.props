<Project>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      Explicit next development release line for installable `main.N` packages only. The main-build
      workflow reads this value and overrides Version/PackageVersion; ordinary source-tree builds
      keep their existing version identity so advancing the next release line cannot silently alter
      product output/golden evidence. The public release workflow remains tag/scenario driven.
    -->
    <ArchLinterDevelopmentVersion>0.8.0</ArchLinterDevelopmentVersion>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.658</VersionSuffix>
    <Authors>Eugene Malashchuk</Authors>
    <Company>Eugene Malashchuk</Company>
    <Copyright>Copyright (c) 2026 Eugene Malashchuk</Copyright>
    <PackageProjectUrl>https://eugenemalaschuk-source.github.io/arch-linter-net/</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>architecture;linting;dotnet;yaml;ci</PackageTags>
    <RepositoryUrl>https://github.com/eugenemalaschuk-source/arch-linter-net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
</Project>
