  "resolutionContract": {
    "sourcePrecedence": [
      "yaml_override",
      "type_attribute",
      "assembly_attribute",
      "inheritance",
      "namespace",
      "path"
    ],
    "canonicalEvidenceAtSameSpecificity": "equivalent role and metadata coalesce with provenance; contradictory roles or metadata fail closed, with no effective role for role conflict",
    "typeRoleVersusAssemblyRole": "type role wins; losing assembly role metadata is not merged",
    "metadataComposition": [
      "winning role evidence",
      "type context attributes",
      "assembly context defaults for absent keys"
    ],
    "sameScopeContextConflict": "omit only the conflicting key and retain an otherwise valid role",
    "apiMembership": "ApiContract is a primary semantic role; reviewed API membership remains an independent policy selector"
  },
  "compatibility": {
    "generation1WithinPackageRange": "preserves FQNs, meanings, scopes, constructors, and metadata property names/types",
    "catalogGenerationIsSeparateFromSemVer": true,
    "assemblyMetadataSufficientForTargetAssembliesOnly": true,
    "missingCatalogIdentityBehavior": "when a canonical annotation FQN is present without exactly one catalog identity marker, report a deterministic missing-or-invalid catalog identity diagnostic and do not resolve canonical annotation evidence",
    "unsupportedGenerationBehavior": "annotation-aware tools fail closed with a deterministic diagnostic",
    "invalidOrUnsupportedPackageVersionBehavior": "when the marker package version is malformed or outside the tool-advertised supported range, report a deterministic package-version compatibility diagnostic and do not resolve canonical annotation evidence",
    "preV010ToolLimitation": "tools older than 0.10.0 cannot diagnose source-only annotation metadata retroactively"
  }
