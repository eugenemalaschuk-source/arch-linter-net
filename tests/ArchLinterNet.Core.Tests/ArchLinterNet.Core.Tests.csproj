<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <!--
      NUnit3TestAdapter defaults AssemblySelectLimit to 2000. Above that threshold it may discard
      the VSTest-selected test list and execute the whole assembly, which makes our deterministic
      Core shard filters fail open as the suite grows. Keep the adapter settings project-scoped so
      every dotnet-test entrypoint preserves the authored FullyQualifiedName selection.
    -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)core-test-selection.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="7.4.0" />
    <PackageReference Include="NJsonSchema" Version="11.6.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ArchLinterNet.CEL\ArchLinterNet.CEL.csproj" />
    <ProjectReference Include="..\..\src\ArchLinterNet.Cli\ArchLinterNet.Cli.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\ArchLinterNet.Core\ArchLinterNet.Core.csproj" />
    <ProjectReference Include="..\..\src\ArchLinterNet.Testing\ArchLinterNet.Testing.csproj" />
    <ProjectReference Include="..\ArchLinterNet.Annotations.CSharp9Consumer\ArchLinterNet.Annotations.CSharp9Consumer.csproj" />
    <ProjectReference Include="..\..\tools\ArchLinterNet.GitFuzz\ArchLinterNet.GitFuzz.csproj" />
    <ProjectReference Include="..\..\tools\ArchLinterNet.ProcessTreeProbe\ArchLinterNet.ProcessTreeProbe.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="AdoptionAcceptance\Fixtures\**\*.cs" />
    <Compile Include="..\..\src\ArchLinterNet.Annotations\contentFiles\cs\any\**\*.cs" Link="SemanticAnnotations\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="AdoptionAcceptance\Fixtures\**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="ApprovedApi\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="SarifSchemas\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\architecture\semantic-annotations.v1.json" Link="architecture\semantic-annotations.v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\ArchLinterNet.GitFuzz\corpus-source\*.hex" Link="corpus-source\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
