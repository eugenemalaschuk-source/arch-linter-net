<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ArchLinterNet.Core\ArchLinterNet.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>arch-linter-net</ToolCommandName>
    <IsPackable>true</IsPackable>
    <PackageId>ArchLinterNet.Cli</PackageId>
    <Description>.NET tool for running ArchLinterNet architecture contracts from YAML policies. Supports strict and audit modes with human and JSON output.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ArchLinterNet.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Relay is transport-owned, but its closed public profile contract travels with the
         tool that produces those bytes. Global-tool consumers can therefore validate a shipped
         fixture set without a source checkout. -->
    <Content Include="..\..\docs\internal\architecture-health-badge-relay-fixtures\**\*"
             Pack="true"
             PackagePath="tools/net10.0/any/architecture-health-badge-relay" />
  </ItemGroup>

</Project>
