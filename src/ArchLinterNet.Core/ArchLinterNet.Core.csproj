<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>ArchLinterNet.Core</PackageId>
    <Description>YAML-first architecture contract engine for .NET projects. Loads declarative architecture policies, resolves assemblies, and validates dependency and Unity asmdef rules.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArchLinterNet.CEL\ArchLinterNet.CEL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ArchLinterNet.Core.Tests" />
    <InternalsVisibleTo Include="ArchLinterNet.Cli" />
    <InternalsVisibleTo Include="ArchLinterNet.GitFuzz" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Buildalyzer" Version="9.0.0" />
    <PackageReference Include="JsonSchema.Net" Version="9.5.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="4.14.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <!-- Buildalyzer brings Xml transitively; pin Xml and its Pkcs dependency to patched 9.0.21
         for the October 2026 advisories: GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj,
         GHSA-r955-8q5j-3h83, GHSA-2fmv-rv2c-59x7, and GHSA-846f-f764-76mx. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\schema\dependencies.arch.schema.json" Link="Schema\dependencies.arch.schema.json" />
    <EmbeddedResource Include="..\..\architecture\semantic-annotations.v1.json" Link="SemanticAnnotations\semantic-annotations.v1.json" LogicalName="ArchLinterNet.Core.SemanticAnnotations.semantic-annotations.v1.json" />
    <EmbeddedResource Include="..\..\schema\dependencies.arch.fragment.schema.json" Link="Schema\dependencies.arch.fragment.schema.json" />
    <EmbeddedResource Include="..\..\schema\baseline.schema.json" Link="Schema\baseline.schema.json" />
    <!-- Frozen packaged-registry snapshots of the policy-root/policy-fragment schemas, distinct
         from the live top-level dependencies.arch(.fragment).schema.json above: each packaged
         registry entry's bytes and $id are an immutable release contract
         (openspec/specs/packaged-schema-registry), while the live files keep evolving (e.g.
         layers.overlaps_with) for runtime authoring/import validation. The frozen 0.5.1 policy-root
         schema (schema/0.5.1/dependencies.arch.schema.json) predates overlaps_with and is preserved
         byte-for-byte in source control but is no longer registry-embedded/discoverable, since
         "policy-root"/"policy-fragment" now resolve to the 0.8.0 snapshots below. See
         schema/0.8.0/compatibility-manifest.json. -->
    <EmbeddedResource Include="..\..\schema\0.8.0\dependencies.arch.schema.json" Link="Schema\0.8.0\dependencies.arch.schema.json" LogicalName="ArchLinterNet.Core.Schema.0.8.0.dependencies.arch.schema.json" />
    <EmbeddedResource Include="..\..\schema\0.8.0\dependencies.arch.fragment.schema.json" Link="Schema\0.8.0\dependencies.arch.fragment.schema.json" LogicalName="ArchLinterNet.Core.Schema.0.8.0.dependencies.arch.fragment.schema.json" />
    <EmbeddedResource Include="..\..\schema\0.8.0\normalized-finding.schema.json" Link="Schema\0.8.0\normalized-finding.schema.json" LogicalName="ArchLinterNet.Core.Schema.0.8.0.normalized-finding.schema.json" />
    <EmbeddedResource Include="..\..\schema\0.8.0\analysis-cache.schema.json" Link="Schema\0.8.0\analysis-cache.schema.json" LogicalName="ArchLinterNet.Core.Schema.0.8.0.analysis-cache.schema.json" />
    <EmbeddedResource Include="..\..\schema\0.8.0\baseline.schema.json" Link="Schema\0.8.0\baseline.schema.json" LogicalName="ArchLinterNet.Core.Schema.0.8.0.baseline.schema.json" />
    <!-- The 0.8.0 manifest and its listed schema bytes remain immutable and packaged for existing
         consumers. PackagedSchemaRegistry loads the 0.10.0 manifest, which advances only the
         analysis-cache entry to its new 0.10.0 identity while retaining the policy-root,
         policy-fragment, baseline, and normalized-finding identities at 0.8.0 and unaffected
         entries at 0.5.1. Frozen finding/cache resources at 0.5.1, 0.6.1, and 0.8.0 remain
         packaged as legacy contracts. -->
    <EmbeddedResource Include="..\..\schema\0.8.0\compatibility-manifest.json" Link="Schema\0.8.0\compatibility-manifest.json" LogicalName="ArchLinterNet.Core.Schema.0.8.0.compatibility-manifest.json" />
    <EmbeddedResource Include="..\..\schema\0.10.0\analysis-cache.schema.json" Link="Schema\0.10.0\analysis-cache.schema.json" LogicalName="ArchLinterNet.Core.Schema.0.10.0.analysis-cache.schema.json" />
    <EmbeddedResource Include="..\..\schema\0.10.0\compatibility-manifest.json" Link="Schema\0.10.0\compatibility-manifest.json" LogicalName="ArchLinterNet.Core.Schema.0.10.0.compatibility-manifest.json" />
    <EmbeddedResource Include="..\..\schema\0.5.1\api-snapshot.schema.json" Link="Schema\0.5.1\api-snapshot.schema.json" LogicalName="ArchLinterNet.Core.Schema.0.5.1.api-snapshot.schema.json" />
    <EmbeddedResource Include="..\..\schema\0.6.1\normalized-finding.schema.json" Link="Schema\0.6.1\normalized-finding.schema.json" LogicalName="ArchLinterNet.Core.Schema.0.6.1.normalized-finding.schema.json" />
    <EmbeddedResource Include="..\..\schema\0.5.1\analysis-build-state.schema.json" Link="Schema\0.5.1\analysis-build-state.schema.json" LogicalName="ArchLinterNet.Core.Schema.0.5.1.analysis-build-state.schema.json" />
    <EmbeddedResource Include="..\..\schema\0.6.1\analysis-cache.schema.json" Link="Schema\0.6.1\analysis-cache.schema.json" LogicalName="ArchLinterNet.Core.Schema.0.6.1.analysis-cache.schema.json" />
    <EmbeddedResource Include="..\..\schema\0.5.1\analysis-profile.schema.json" Link="Schema\0.5.1\analysis-profile.schema.json" LogicalName="ArchLinterNet.Core.Schema.0.5.1.analysis-profile.schema.json" />
    <Content Include="..\..\schema\0.8.0\dependencies.arch.schema.json" Pack="true" PackagePath="contentFiles/any/any/schema/0.8.0/dependencies.arch.schema.json" />
    <Content Include="..\..\schema\0.8.0\dependencies.arch.fragment.schema.json" Pack="true" PackagePath="contentFiles/any/any/schema/0.8.0/dependencies.arch.fragment.schema.json" />
    <Content Include="..\..\schema\0.8.0\normalized-finding.schema.json" Pack="true" PackagePath="contentFiles/any/any/schema/0.8.0/normalized-finding.schema.json" />
    <Content Include="..\..\schema\0.8.0\analysis-cache.schema.json" Pack="true" PackagePath="contentFiles/any/any/schema/0.8.0/analysis-cache.schema.json" />
    <Content Include="..\..\schema\0.8.0\baseline.schema.json" Pack="true" PackagePath="contentFiles/any/any/schema/0.8.0/baseline.schema.json" />
    <Content Include="..\..\schema\0.8.0\compatibility-manifest.json" Pack="true" PackagePath="contentFiles/any/any/schema/0.8.0/" />
    <Content Include="..\..\schema\0.10.0\analysis-cache.schema.json" Pack="true" PackagePath="contentFiles/any/any/schema/0.10.0/analysis-cache.schema.json" />
    <Content Include="..\..\schema\0.10.0\compatibility-manifest.json" Pack="true" PackagePath="contentFiles/any/any/schema/0.10.0/" />
    <Content Include="..\..\schema\0.5.1\api-snapshot.schema.json" Pack="true" PackagePath="contentFiles/any/any/schema/0.5.1/" />
    <Content Include="..\..\schema\0.5.1\baseline.schema.json" Pack="true" PackagePath="contentFiles/any/any/schema/0.5.1/" />
    <Content Include="..\..\schema\0.5.1\normalized-finding.schema.json" Pack="true" PackagePath="contentFiles/any/any/schema/0.5.1/" />
    <Content Include="..\..\schema\0.6.1\normalized-finding.schema.json" Pack="true" PackagePath="contentFiles/any/any/schema/0.6.1/" />
    <Content Include="..\..\schema\0.5.1\analysis-build-state.schema.json" Pack="true" PackagePath="contentFiles/any/any/schema/0.5.1/" />
    <Content Include="..\..\schema\0.5.1\analysis-cache.schema.json" Pack="true" PackagePath="contentFiles/any/any/schema/0.5.1/" />
    <Content Include="..\..\schema\0.6.1\analysis-cache.schema.json" Pack="true" PackagePath="contentFiles/any/any/schema/0.6.1/" />
    <Content Include="..\..\schema\0.5.1\analysis-profile.schema.json" Pack="true" PackagePath="contentFiles/any/any/schema/0.5.1/" />
  </ItemGroup>

</Project>
