<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>ArchLinterNet.Core</PackageId>
    <Description>YAML-first architecture contract engine for .NET projects. Loads declarative architecture policies, resolves assemblies, and validates dependency and Unity asmdef rules.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArchLinterNet.CEL\ArchLinterNet.CEL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ArchLinterNet.Core.Tests" />
    <InternalsVisibleTo Include="ArchLinterNet.Cli" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Buildalyzer" Version="9.0.0" />
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="4.14.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <!-- Pins Buildalyzer's transitive System.Security.Cryptography.Xml above the version flagged by
         GHSA-37gx-xxp4-5rgx / GHSA-w3x6-4m5h-cxqf (CVE-2026-33116 EncryptedXml DoS), and above the
         later 9.0.17 advisories (GHSA-cvvh-rhrc-wg4q, GHSA-g8r8-53c2-pm3f, GHSA-23rf-6693-g89p,
         GHSA-8q5v-6pqq-x66h, GHSA-mmjf-rqrv-855v). -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="9.0.18" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\schema\dependencies.arch.schema.json" Link="Schema\dependencies.arch.schema.json" />
    <EmbeddedResource Include="..\..\schema\dependencies.arch.fragment.schema.json" Link="Schema\dependencies.arch.fragment.schema.json" />
    <EmbeddedResource Include="..\..\schema\baseline.schema.json" Link="Schema\baseline.schema.json" />
    <!-- Frozen packaged-registry snapshots of the policy-root/policy-fragment schemas, distinct
         from the live top-level dependencies.arch(.fragment).schema.json above: each packaged
         registry entry's bytes and $id are an immutable release contract
         (openspec/specs/packaged-schema-registry), while the live files keep evolving (e.g.
         layers.overlaps_with) for runtime authoring/import validation. The frozen 0.5.1 policy-root
         schema (schema/0.5.1/dependencies.arch.schema.json) predates overlaps_with and is preserved
         byte-for-byte in source control but is no longer registry-embedded/discoverable, since
         "policy-root"/"policy-fragment" now resolve to the 0.6.1 snapshots below. See
         schema/0.6.1/compatibility-manifest.json. -->
    <EmbeddedResource Include="..\..\schema\0.6.1\dependencies.arch.schema.json" Link="Schema\0.6.1\dependencies.arch.schema.json" LogicalName="ArchLinterNet.Core.Schema.0.6.1.dependencies.arch.schema.json" />
    <EmbeddedResource Include="..\..\schema\0.6.1\dependencies.arch.fragment.schema.json" Link="Schema\0.6.1\dependencies.arch.fragment.schema.json" LogicalName="ArchLinterNet.Core.Schema.0.6.1.dependencies.arch.fragment.schema.json" />
    <!-- The manifest itself is release-qualified (its own $id/bytes are the immutable contract),
         so advancing any entry (policy-root/policy-fragment to 0.6.1) requires a new manifest
         generation rather than editing schema/0.5.1/compatibility-manifest.json in place - that
         file stays byte-for-byte frozen (preserved, no longer embedded) alongside the frozen
         policy-root/policy-fragment schemas above. PackagedSchemaRegistry loads this 0.6.1
         manifest, which lists policy-root/policy-fragment at 0.6.1 and every other schema
         unchanged at its existing 0.5.1 identity. -->
    <EmbeddedResource Include="..\..\schema\0.6.1\compatibility-manifest.json" Link="Schema\0.6.1\compatibility-manifest.json" LogicalName="ArchLinterNet.Core.Schema.0.6.1.compatibility-manifest.json" />
    <EmbeddedResource Include="..\..\schema\0.5.1\api-snapshot.schema.json" Link="Schema\0.5.1\api-snapshot.schema.json" LogicalName="ArchLinterNet.Core.Schema.0.5.1.api-snapshot.schema.json" />
    <EmbeddedResource Include="..\..\schema\0.5.1\normalized-finding.schema.json" Link="Schema\0.5.1\normalized-finding.schema.json" LogicalName="ArchLinterNet.Core.Schema.0.5.1.normalized-finding.schema.json" />
    <EmbeddedResource Include="..\..\schema\0.5.1\analysis-build-state.schema.json" Link="Schema\0.5.1\analysis-build-state.schema.json" LogicalName="ArchLinterNet.Core.Schema.0.5.1.analysis-build-state.schema.json" />
    <EmbeddedResource Include="..\..\schema\0.5.1\analysis-cache.schema.json" Link="Schema\0.5.1\analysis-cache.schema.json" LogicalName="ArchLinterNet.Core.Schema.0.5.1.analysis-cache.schema.json" />
    <EmbeddedResource Include="..\..\schema\0.5.1\analysis-profile.schema.json" Link="Schema\0.5.1\analysis-profile.schema.json" LogicalName="ArchLinterNet.Core.Schema.0.5.1.analysis-profile.schema.json" />
    <Content Include="..\..\schema\0.6.1\dependencies.arch.schema.json" Pack="true" PackagePath="contentFiles/any/any/schema/0.6.1/dependencies.arch.schema.json" />
    <Content Include="..\..\schema\0.6.1\dependencies.arch.fragment.schema.json" Pack="true" PackagePath="contentFiles/any/any/schema/0.6.1/dependencies.arch.fragment.schema.json" />
    <Content Include="..\..\schema\baseline.schema.json" Pack="true" PackagePath="contentFiles/any/any/schema/0.5.1/baseline.schema.json" />
    <Content Include="..\..\schema\0.6.1\compatibility-manifest.json" Pack="true" PackagePath="contentFiles/any/any/schema/0.6.1/" />
    <Content Include="..\..\schema\0.5.1\api-snapshot.schema.json" Pack="true" PackagePath="contentFiles/any/any/schema/0.5.1/" />
    <Content Include="..\..\schema\0.5.1\normalized-finding.schema.json" Pack="true" PackagePath="contentFiles/any/any/schema/0.5.1/" />
    <Content Include="..\..\schema\0.5.1\analysis-build-state.schema.json" Pack="true" PackagePath="contentFiles/any/any/schema/0.5.1/" />
    <Content Include="..\..\schema\0.5.1\analysis-cache.schema.json" Pack="true" PackagePath="contentFiles/any/any/schema/0.5.1/" />
    <Content Include="..\..\schema\0.5.1\analysis-profile.schema.json" Pack="true" PackagePath="contentFiles/any/any/schema/0.5.1/" />
  </ItemGroup>

</Project>
