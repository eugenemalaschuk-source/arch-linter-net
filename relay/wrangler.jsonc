{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "badge-relay-v1",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "RELAY", "class_name": "RelayDurableObject" },
      { "name": "REGISTRY", "class_name": "RelayRegistryDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RelayDurableObject", "RelayRegistryDurableObject"] }
  ]
}
