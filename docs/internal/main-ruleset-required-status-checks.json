{
  "name": "Main",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": ["~DEFAULT_BRANCH"]
    }
  },
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "code_coverage",
      "parameters": { "minimum_coverage": 80 }
    },
    {
      "type": "code_quality",
      "parameters": { "severity": "warnings" }
    },
    {
      "type": "code_scanning",
      "parameters": {
        "code_scanning_tools": [
          {
            "tool": "CodeQL",
            "security_alerts_threshold": "medium_or_higher",
            "alerts_threshold": "errors"
          }
        ]
      }
    },
    { "type": "required_linear_history" },
    { "type": "creation" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "required_reviewers": [],
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "require_extra_approval_for_unattributed_changes": true,
        "allowed_merge_methods": ["squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "Workflow Quality", "integration_id": 15368 },
          { "context": "Repository Lint", "integration_id": 15368 },
          { "context": "Coverage + Sonar" },
          { "context": "qodana", "integration_id": 15368 },
          { "context": "Architecture Coverage", "integration_id": 15368 },
          { "context": "Tooling / Support Tests" },
          { "context": "Unit Test Suite (Windows / Core Shard 1)" },
          { "context": "Unit Test Suite (Windows / Core Shard 2)" },
          { "context": "Unit Test Suite (Apple Silicon macOS / Core Shard 1)" },
          { "context": "Unit Test Suite (Apple Silicon macOS / Core Shard 2)" },
          { "context": "E2E Test Suite (Windows)" },
          { "context": "E2E Test Suite (Apple Silicon macOS)" },
          { "context": "Packed Artifact Test Suite (Windows)" },
          { "context": "Packed Artifact Test Suite (Apple Silicon macOS)" },
          { "context": "Analyze C#" },
          { "context": "Validate NuGet Packages" }
        ]
      }
    }
  ]
}
