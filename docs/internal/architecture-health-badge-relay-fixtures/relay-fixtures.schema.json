{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arch-linter-net.invalid/schemas/architecture-health-badge-relay-fixtures-v1.json",
  "title": "Architecture Health Badge Relay executable fixtures",
  "description": "Closed, synthetic v1 fixtures for a transport-only badge relay. The suite accepts one reference configuration, one headline-only or freshness public representation, or a conformance-vector collection.",
  "oneOf": [
    {
      "$ref": "#/$defs/referenceConfig"
    },
    {
      "$ref": "#/$defs/readyRepresentation"
    },
    {
      "$ref": "#/$defs/freshnessRepresentation"
    },
    {
      "$ref": "#/$defs/unavailableRepresentation"
    },
    {
      "$ref": "#/$defs/conformanceVectors"
    }
  ],
  "$defs": {
    "alias": {
      "type": "string",
      "description": "Opaque fixture alias; it is not a repository, owner, URL, or display name.",
      "pattern": "^a[0-9a-z]{7}$",
      "minLength": 8,
      "maxLength": 8
    },
    "sha256": {
      "type": "string",
      "description": "Lower-case hexadecimal SHA-256 digest used only as synthetic fixture data.",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "gitSha": {
      "type": "string",
      "description": "Synthetic immutable commit or workflow pin; never a public payload field.",
      "pattern": "^[0-9a-f]{40}$",
      "minLength": 40,
      "maxLength": 40
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "profile": {
      "type": "string",
      "enum": [
        "headline-only/v1",
        "headline-plus-freshness/v1"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "none",
        "github-raw",
        "relay",
        "custom"
      ]
    },
    "headlinePayload": {
      "type": "object",
      "description": "The exact CLI-owned Shields-compatible payload. Property order in canonical_bytes is schemaVersion, label, message, color.",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "label",
        "message",
        "color"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "label": {
          "type": "string",
          "const": "architecture"
        },
        "message": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^(PASS|FAIL) · (HEALTHY|DEBT|DEGRADING|FAILING) · (0|[1-9][0-9]{0,3}) ignores · (0|[1-9][0-9]{0,3}) rules$|^UNASSESSABLE · \\? ignores · \\? rules$"
        },
        "color": {
          "type": "string",
          "enum": [
            "brightgreen",
            "yellow",
            "orange",
            "red",
            "lightgrey"
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "message": { "pattern": "^(PASS|FAIL) · HEALTHY ·" } }, "required": [ "message" ] },
          "then": { "properties": { "color": { "const": "brightgreen" } } }
        },
        {
          "if": { "properties": { "message": { "pattern": "^(PASS|FAIL) · DEBT ·" } }, "required": [ "message" ] },
          "then": { "properties": { "color": { "const": "yellow" } } }
        },
        {
          "if": { "properties": { "message": { "pattern": "^(PASS|FAIL) · DEGRADING ·" } }, "required": [ "message" ] },
          "then": { "properties": { "color": { "const": "orange" } } }
        },
        {
          "if": { "properties": { "message": { "pattern": "^(PASS|FAIL) · FAILING ·" } }, "required": [ "message" ] },
          "then": { "properties": { "color": { "const": "red" } } }
        },
        {
          "if": { "properties": { "message": { "const": "UNASSESSABLE · ? ignores · ? rules" } }, "required": [ "message" ] },
          "then": { "properties": { "color": { "const": "lightgrey" } } }
        }
      ]
    },
    "freshnessPayload": {
      "type": "object",
      "description": "The headline payload with the only two permitted freshness fields.",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "label",
        "message",
        "color",
        "verified_at",
        "valid_until"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "label": {
          "type": "string",
          "const": "architecture"
        },
        "message": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^(PASS|FAIL) · (HEALTHY|DEBT|DEGRADING|FAILING) · (0|[1-9][0-9]{0,3}) ignores · (0|[1-9][0-9]{0,3}) rules$|^UNASSESSABLE · \\? ignores · \\? rules$"
        },
        "color": {
          "type": "string",
          "enum": [
            "brightgreen",
            "yellow",
            "orange",
            "red",
            "lightgrey"
          ]
        },
        "verified_at": {
          "$ref": "#/$defs/timestamp"
        },
        "valid_until": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "message": { "pattern": "^(PASS|FAIL) · HEALTHY ·" } }, "required": [ "message" ] },
          "then": { "properties": { "color": { "const": "brightgreen" } } }
        },
        {
          "if": { "properties": { "message": { "pattern": "^(PASS|FAIL) · DEBT ·" } }, "required": [ "message" ] },
          "then": { "properties": { "color": { "const": "yellow" } } }
        },
        {
          "if": { "properties": { "message": { "pattern": "^(PASS|FAIL) · DEGRADING ·" } }, "required": [ "message" ] },
          "then": { "properties": { "color": { "const": "orange" } } }
        },
        {
          "if": { "properties": { "message": { "pattern": "^(PASS|FAIL) · FAILING ·" } }, "required": [ "message" ] },
          "then": { "properties": { "color": { "const": "red" } } }
        },
        {
          "if": { "properties": { "message": { "const": "UNASSESSABLE · ? ignores · ? rules" } }, "required": [ "message" ] },
          "then": { "properties": { "color": { "const": "lightgrey" } } }
        }
      ]
    },
    "publicPayload": {
      "oneOf": [
        {
          "$ref": "#/$defs/headlinePayload"
        },
        {
          "$ref": "#/$defs/freshnessPayload"
        }
      ]
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_minutes",
        "renewal_minimum_minutes",
        "oidc_clock_skew_seconds"
      ],
      "properties": {
        "max_minutes": {
          "type": "integer",
          "const": 60
        },
        "renewal_minimum_minutes": {
          "type": "integer",
          "const": 30
        },
        "oidc_clock_skew_seconds": {
          "type": "integer",
          "const": 300
        },
        "maximum_renewals_per_day": {
          "type": "integer",
          "const": 48
        }
      }
    },
    "registryEntry": {
      "type": "object",
      "description": "Synthetic private registry input. Numeric IDs and exact pins are authorization inputs; none are public response fields.",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "repository_owner_id",
        "owner",
        "repository",
        "destination_alias",
        "permitted_event",
        "permitted_ref",
        "job_workflow_ref",
        "job_workflow_sha",
        "disclosure_profile"
      ],
      "properties": {
        "repository_id": {
          "type": "integer",
          "minimum": 1
        },
        "repository_owner_id": {
          "type": "integer",
          "minimum": 1
        },
        "owner": {
          "type": "string",
          "pattern": "^synthetic-owner-[0-9]{3}$"
        },
        "repository": {
          "type": "string",
          "pattern": "^synthetic-repo-[0-9]{3}$"
        },
        "destination_alias": {
          "$ref": "#/$defs/alias"
        },
        "permitted_event": {
          "type": "string",
          "const": "push"
        },
        "permitted_ref": {
          "type": "string",
          "const": "refs/heads/main"
        },
        "job_workflow_ref": {
          "type": "string",
          "pattern": "^synthetic-owner-[0-9]{3}/synthetic-repo-[0-9]{3}/\\.github/workflows/[a-z0-9._-]+\\.yml@refs/heads/[a-z0-9._/-]+$"
        },
        "job_workflow_sha": {
          "$ref": "#/$defs/gitSha"
        },
        "disclosure_profile": {
          "$ref": "#/$defs/profile"
        }
      }
    },
    "referenceConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_type",
        "schema_id",
        "contract_version",
        "mode",
        "disclosure_profile",
        "bundle",
        "compatibility_plan",
        "destination_alias",
        "lease",
        "registry_entry",
        "oidc_trust",
        "initial_state",
        "transport"
      ],
      "properties": {
        "fixture_type": {
          "type": "string",
          "const": "reference-config"
        },
        "schema_id": {
          "type": "string",
          "const": "architecture-health-badge-relay-config/v1"
        },
        "contract_version": {
          "type": "string",
          "const": "v1"
        },
        "mode": {
          "$ref": "#/$defs/mode"
        },
        "disclosure_profile": {
          "$ref": "#/$defs/profile"
        },
        "bundle": {
          "type": "string",
          "const": "badge-relay/v1"
        },
        "compatibility_plan": {
          "type": "string",
          "const": "architecture-health-badge-relay/v1"
        },
        "destination_alias": {
          "$ref": "#/$defs/alias"
        },
        "lease": {
          "$ref": "#/$defs/lease"
        },
        "registry_entry": {
          "$ref": "#/$defs/registryEntry"
        },
        "oidc_trust": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issuer",
            "jwks_uri",
            "audience",
            "allowed_algorithms",
            "subject"
          ],
          "properties": {
            "issuer": {
              "type": "string",
              "const": "https://token.actions.githubusercontent.com"
            },
            "jwks_uri": {
              "type": "string",
              "const": "https://token.actions.githubusercontent.com/.well-known/jwks"
            },
            "audience": {
              "type": "string",
              "const": "architecture-health-badge-relay-fixture"
            },
            "allowed_algorithms": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "RS256"
                ]
              },
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true
            },
            "subject": {
              "type": "string",
              "pattern": "^repo:synthetic-owner-[0-9]{3}/synthetic-repo-[0-9]{3}:ref:refs/heads/[a-z0-9._/-]+$"
            }
          }
        },
        "initial_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generation",
            "revocation_epoch",
            "tree_sha",
            "semantic_horizon",
            "ready_digest"
          ],
          "properties": {
            "generation": {
              "type": "integer",
              "minimum": 1
            },
            "revocation_epoch": {
              "type": "integer",
              "minimum": 0
            },
            "tree_sha": {
              "$ref": "#/$defs/gitSha"
            },
            "semantic_horizon": {
              "$ref": "#/$defs/timestamp"
            },
            "ready_digest": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "transport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonical_encoding",
            "verification",
            "public_metadata"
          ],
          "properties": {
            "canonical_encoding": {
              "type": "string",
              "const": "utf-8-system-text-json-default-escaping"
            },
            "verification": {
              "type": "string",
              "const": "verify-and-copy"
            },
            "public_metadata": {
              "type": "string",
              "const": "payload-and-safe-freshness-only"
            }
          }
        }
      }
    },
    "readyRepresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_type",
        "schema_id",
        "state",
        "profile",
        "payload",
        "canonical_bytes",
        "sha256",
        "verified_at",
        "valid_until"
      ],
      "properties": {
        "fixture_type": {
          "type": "string",
          "const": "canonical-ready"
        },
        "schema_id": {
          "type": "string",
          "const": "architecture-health-badge-relay-representation/v1"
        },
        "state": {
          "type": "string",
          "const": "ready"
        },
        "profile": {
          "type": "string",
          "const": "headline-only/v1"
        },
        "payload": {
          "$ref": "#/$defs/headlinePayload"
        },
        "canonical_bytes": {
          "type": "string",
          "pattern": "^\\{\\\"schemaVersion\\\":1,\\\"label\\\":\\\"architecture\\\",\\\"message\\\":\\\"((PASS|FAIL) \\\\u00B7 (HEALTHY|DEBT|DEGRADING|FAILING) \\\\u00B7 (0|[1-9][0-9]{0,3}) ignores \\\\u00B7 (0|[1-9][0-9]{0,3}) rules|UNASSESSABLE \\\\u00B7 \\\\? ignores \\\\u00B7 \\\\? rules)\\\",\\\"color\\\":\\\"(brightgreen|yellow|orange|red|lightgrey)\\\"\\}$",
          "maxLength": 256
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "verified_at": {
          "$ref": "#/$defs/timestamp"
        },
        "valid_until": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "freshnessRepresentation": {
      "type": "object",
      "description": "Exact-byte golden representation for headline-plus-freshness/v1. Canonical key order is schemaVersion, label, message, color, verified_at, valid_until.",
      "additionalProperties": false,
      "required": [
        "fixture_type",
        "schema_id",
        "state",
        "profile",
        "payload",
        "canonical_bytes",
        "sha256",
        "verified_at",
        "valid_until"
      ],
      "properties": {
        "fixture_type": {
          "type": "string",
          "const": "canonical-freshness"
        },
        "schema_id": {
          "type": "string",
          "const": "architecture-health-badge-relay-representation/v1"
        },
        "state": {
          "type": "string",
          "const": "ready"
        },
        "profile": {
          "type": "string",
          "const": "headline-plus-freshness/v1"
        },
        "payload": {
          "$ref": "#/$defs/freshnessPayload"
        },
        "canonical_bytes": {
          "type": "string",
          "pattern": "^\\{\\\"schemaVersion\\\":1,\\\"label\\\":\\\"architecture\\\",\\\"message\\\":\\\"((PASS|FAIL) \\\\u00B7 (HEALTHY|DEBT|DEGRADING|FAILING) \\\\u00B7 (0|[1-9][0-9]{0,3}) ignores \\\\u00B7 (0|[1-9][0-9]{0,3}) rules|UNASSESSABLE \\\\u00B7 \\\\? ignores \\\\u00B7 \\\\? rules)\\\",\\\"color\\\":\\\"(brightgreen|yellow|orange|red|lightgrey)\\\",\\\"verified_at\\\":\\\"20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z\\\",\\\"valid_until\\\":\\\"20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z\\\"\\}$",
          "maxLength": 384
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "verified_at": {
          "$ref": "#/$defs/timestamp"
        },
        "valid_until": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "unavailableRepresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_type",
        "schema_id",
        "state",
        "profile",
        "payload",
        "canonical_bytes",
        "sha256",
        "reason_code"
      ],
      "properties": {
        "fixture_type": {
          "type": "string",
          "const": "canonical-unavailable"
        },
        "schema_id": {
          "type": "string",
          "const": "architecture-health-badge-relay-representation/v1"
        },
        "state": {
          "type": "string",
          "const": "unavailable"
        },
        "profile": {
          "type": "string",
          "const": "headline-only/v1"
        },
        "payload": {
          "$ref": "#/$defs/headlinePayload"
        },
        "canonical_bytes": {
          "type": "string",
          "const": "{\"schemaVersion\":1,\"label\":\"architecture\",\"message\":\"UNASSESSABLE \\u00B7 ? ignores \\u00B7 ? rules\",\"color\":\"lightgrey\"}"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "no_current_confirmation",
            "expired",
            "revoked",
            "invalid_input"
          ]
        }
      }
    },
    "publicResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "ready",
            "expired",
            "unavailable",
            "revoked"
          ]
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "representation": {
          "type": "string",
          "enum": [
            "json",
            "svg"
          ]
        },
        "payload": {
          "$ref": "#/$defs/publicPayload"
        },
        "body": {
          "type": "string",
          "maxLength": 16384
        },
        "body_assertions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "template": {
              "type": "string",
              "const": "fixed-local-svg/v1"
            },
            "must_include": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "string",
                "maxLength": 240
              }
            },
            "must_exclude": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "maxLength": 240
              }
            }
          }
        },
        "headers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "content_type": {
              "type": "string",
              "enum": [
                "application/json; charset=utf-8",
                "image/svg+xml; charset=utf-8"
              ]
            },
            "x_content_type_options": {
              "type": "string",
              "const": "nosniff"
            },
            "cache_control": {
              "type": "string",
              "pattern": "^(public, max-age=[0-9]{1,5}, must-revalidate|no-store)$"
            },
            "etag": {
              "type": "string",
              "pattern": "^\"[0-9a-f]{64}\"$"
            },
            "status": {
              "type": "integer",
              "enum": [
                200,
                304,
                404,
                410,
                503
              ]
            }
          }
        }
      }
    },
    "conformanceVector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "purpose",
        "request",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "category": {
          "type": "string",
          "enum": [
            "payload",
            "oidc",
            "pin",
            "replay",
            "ordering",
            "freshness",
            "lifecycle",
            "recovery",
            "cache",
            "rendering"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 12,
          "maxLength": 240
        },
        "request": {
          "type": "object"
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome",
            "reason",
            "public_response"
          ],
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "accepted",
                "rejected",
                "served",
                "not_modified"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 8,
              "maxLength": 240
            },
            "public_response": {
              "$ref": "#/$defs/publicResponse"
            },
            "state_change": {
              "type": "string",
              "enum": [
                "none",
                "ready",
                "unavailable",
                "revoked",
                "expired"
              ]
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 240
          }
        }
      }
    },
    "conformanceVectors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_type",
        "schema_id",
        "vector_version",
        "vectors"
      ],
      "properties": {
        "fixture_type": {
          "type": "string",
          "const": "conformance-vectors"
        },
        "schema_id": {
          "type": "string",
          "const": "architecture-health-badge-relay-vectors/v1"
        },
        "vector_version": {
          "type": "string",
          "const": "v1"
        },
        "vectors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/conformanceVector"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
