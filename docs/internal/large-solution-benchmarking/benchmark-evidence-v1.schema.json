{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archlinternet.dev/schema/benchmark-evidence/v1",
  "title": "ArchLinterNet benchmark-evidence/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_schema_id", "workload", "run", "deterministic_work", "samples", "canonical_result", "environment", "disposition"],
  "properties": {
    "evidence_schema_id": { "const": "benchmark-evidence/v1" },
    "workload": { "$ref": "#/$defs/workload" },
    "run": { "$ref": "#/$defs/run" },
    "deterministic_work": { "$ref": "#/$defs/work" },
    "samples": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sample" } },
    "canonical_result": { "$ref": "#/$defs/canonical_result" },
    "environment": { "$ref": "#/$defs/environment" },
    "complexity": { "anyOf": [{ "$ref": "#/$defs/complexity" }, { "type": "null" }] },
    "expected_effect": { "anyOf": [{ "$ref": "#/$defs/expected_effect" }, { "type": "null" }] },
    "disposition": { "enum": ["candidate", "not_reproduced", "deferred", "implemented"] }
  },
  "$defs": {
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_count", "types_per_project", "source_files_per_project", "references_per_project", "layer_count", "selector_predicate_terms_per_layer", "contracts_per_workload", "finding_candidates", "source_root_count"],
      "properties": {
        "project_count": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "types_per_project": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "source_files_per_project": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "references_per_project": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "layer_count": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "selector_predicate_terms_per_layer": { "type": "integer", "minimum": 1, "maximum": 25 },
        "contracts_per_workload": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "finding_candidates": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "source_root_count": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "ignore_rule_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "metric_rule_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "report_rule_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "method_body_rule_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "generator_version", "workload_id", "shape", "compilation_mode", "dimensions", "projects", "edges", "topology", "inventory", "workflow", "pull_request_change", "workload_identity"],
      "properties": {
        "schema_id": { "const": "large-solution-benchmark/v1" },
        "generator_version": { "type": "string", "minLength": 1 },
        "workload_id": { "type": "string", "pattern": "^synthetic-[a-z0-9-]+$" },
        "shape": { "enum": ["linear", "wide_fan_out_fan_in", "diamond", "dense", "cyclic_scc", "many_projects_few_types", "few_projects_many_types"] },
        "compilation_mode": { "enum": ["real_ms_build", "staged_assemblies"] },
        "dimensions": { "$ref": "#/$defs/dimensions" },
        "projects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/project" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
        "topology": { "$ref": "#/$defs/topology" },
        "inventory": { "$ref": "#/$defs/inventory" },
        "contract_layer_graph": { "$ref": "#/$defs/contract_layer_graph" },
        "workflow": { "$ref": "#/$defs/workflow" },
        "pull_request_change": { "$ref": "#/$defs/pull_request_change" },
        "workload_identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "assembly_name"],
      "properties": { "id": { "type": "string" }, "assembly_name": { "type": "string" } }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_project_id", "to_project_id"],
      "properties": { "from_project_id": { "type": "string" }, "to_project_id": { "type": "string" } }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_count", "reference_edge_count", "strongly_connected_component_count", "contains_cycle", "alternate_path_count"],
      "properties": {
        "project_count": { "type": "integer", "minimum": 1 },
        "reference_edge_count": { "type": "integer", "minimum": 0 },
        "strongly_connected_component_count": { "type": "integer", "minimum": 1 },
        "contains_cycle": { "type": "boolean" },
        "alternate_path_count": { "type": "integer", "minimum": 0 }
      }
    },
    "contract_layer_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "layers", "edges"],
      "properties": {
        "shape": { "enum": ["dense_dag", "layered_dag", "strongly_connected_with_acyclic_tail"] },
        "layers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from_layer", "to_layer"],
            "properties": { "from_layer": { "type": "string" }, "to_layer": { "type": "string" } }
          }
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_count", "assembly_count", "source_file_count", "type_count", "reference_edge_count", "layer_count", "selector_predicate_evaluation_count", "contract_count", "finding_candidate_count", "source_root_count"],
      "properties": {
        "project_count": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "assembly_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "source_file_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "type_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "reference_edge_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "layer_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "selector_predicate_evaluation_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "contract_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "finding_candidate_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "source_root_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "ignore_rule_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "metric_rule_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "report_rule_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "contract_layer_node_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "contract_layer_reference_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "method_body_rule_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_mode", "command_families", "commands", "independent_processes"],
      "properties": {
        "execution_mode": { "enum": ["single_command", "full_governance", "multi_command", "pull_request"] },
        "command_families": { "type": "array", "items": { "type": "string" } },
        "commands": { "type": "array", "items": { "type": "string" } },
        "independent_processes": { "type": "integer", "minimum": 1 }
      }
    },
    "pull_request_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed_project_ids", "changed_source_paths", "includes_global_input"],
      "properties": {
        "changed_project_ids": { "type": "array", "items": { "type": "string" } },
        "changed_source_paths": { "type": "array", "items": { "type": "string" } },
        "includes_global_input": { "type": "boolean" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_mode", "cache_mode", "prepared_state_mode", "parallel_mode", "sample_ordinal", "is_warm_sample"],
      "properties": {
        "execution_mode": { "enum": ["single_command", "full_governance", "multi_command", "pull_request"] },
        "cache_mode": { "type": "string", "minLength": 1 },
        "prepared_state_mode": { "type": "string", "minLength": 1 },
        "parallel_mode": { "type": "string", "minLength": 1 },
        "sample_ordinal": { "type": "integer", "minimum": 1 },
        "is_warm_sample": { "type": "boolean" }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["available", "unavailable", "not_applicable"] },
        "value": { "type": ["integer", "null"] },
        "unit": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "available" } } },
          "then": {
            "required": ["value", "unit"],
            "properties": {
              "value": { "type": "integer", "minimum": 0 },
              "unit": { "type": "string", "minLength": 1 },
              "reason": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "unavailable" } } },
          "then": {
            "required": ["reason"],
            "properties": {
              "value": { "type": "null" },
              "unit": { "type": "null" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "not_applicable" } } },
          "then": {
            "required": ["reason"],
            "properties": {
              "value": { "type": "null" },
              "unit": { "type": "null" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "raw_analysis_profile", "completion_status", "exit_code", "output_failed", "wall_clock", "processor_time", "allocated_bytes", "peak_managed_memory"],
      "properties": {
        "run": { "$ref": "#/$defs/run" },
        "raw_analysis_profile": { "type": "object", "required": ["SchemaId"], "properties": { "SchemaId": { "const": "analysis-profile/v1" } } },
        "raw_analysis_profile_gzip_base64": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$",
          "contentEncoding": "base64",
          "contentMediaType": "application/gzip"
        },
        "raw_analysis_profile_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "completion_status": { "type": "string" },
        "exit_code": { "type": "integer" },
        "output_failed": { "type": "boolean" },
        "wall_clock": { "$ref": "#/$defs/measurement" },
        "processor_time": { "$ref": "#/$defs/measurement" },
        "allocated_bytes": { "$ref": "#/$defs/measurement" },
        "peak_managed_memory": { "$ref": "#/$defs/measurement" },
        "work_counters": { "$ref": "#/$defs/work_counters" },
        "metric_work": { "$ref": "#/$defs/metric_work" },
        "history_work_counters": { "$ref": "#/$defs/history_work_counters" },
        "timing_boundaries": { "$ref": "#/$defs/timing_boundaries" },
        "report_output_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "loaded_assemblies": { "$ref": "#/$defs/loaded_assemblies" }
      },
      "allOf": [
        {
          "if": { "required": ["raw_analysis_profile_gzip_base64"] },
          "then": { "required": ["raw_analysis_profile_sha256"] }
        },
        {
          "if": { "required": ["raw_analysis_profile_sha256"] },
          "then": { "required": ["raw_analysis_profile_gzip_base64"] }
        }
      ]
    },
    "loaded_assembly_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "sha256"],
      "properties": {
        "file_name": { "type": "string", "pattern": "^[^/\\\\]+\\.dll$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "loaded_assemblies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "artifacts"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/loaded_assembly_artifact" } }
      }
    },
    "metric_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "metric_kind", "value", "contributor_count"],
      "properties": {
        "metric_id": { "type": "string", "minLength": 1 },
        "metric_kind": { "type": "string", "minLength": 1 },
        "value": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "contributor_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "metric_work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_count", "is_complete", "results_sha256", "results"],
      "properties": {
        "metric_count": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "is_complete": { "const": true },
        "results_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "results": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/metric_result" } }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_count", "assembly_count", "source_file_count", "type_count", "reference_edge_count", "layer_count", "selector_predicate_evaluation_count", "contract_count", "finding_candidate_count", "source_root_count", "graph_traversal_count", "witness_path_materialization_count", "canonical_identity_candidate_count"],
      "properties": {
        "project_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "assembly_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "source_file_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "type_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "reference_edge_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "layer_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "selector_predicate_evaluation_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "contract_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "finding_candidate_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "source_root_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "graph_traversal_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "witness_path_materialization_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "canonical_identity_candidate_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "work_counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrumentation", "project_file_parses", "source_fact_file_parses", "method_body_compilation_calls", "method_body_syntax_trees", "ast_semantic_lookups", "layer_membership_probes", "cel_context_constructions"],
      "properties": {
        "instrumentation": { "const": "benchmark-work-observer/v1" },
        "project_file_parses": { "$ref": "#/$defs/measurement" },
        "source_fact_file_parses": { "$ref": "#/$defs/measurement" },
        "method_body_compilation_calls": { "$ref": "#/$defs/measurement" },
        "method_body_syntax_trees": { "$ref": "#/$defs/measurement" },
        "ast_semantic_lookups": { "$ref": "#/$defs/measurement" },
        "layer_membership_probes": { "$ref": "#/$defs/measurement" },
        "cel_context_constructions": { "$ref": "#/$defs/measurement" }
      }
    },
    "history_work_counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrumentation", "line_churn_algorithm_work", "task_commit_occurrences_examined", "co_change_edges_assigned", "ancestry_ancestors_visited", "ancestry_retained_entries"],
      "properties": {
        "instrumentation": { "const": "benchmark-history-work/v1" },
        "line_churn_algorithm_work": { "$ref": "#/$defs/measurement" },
        "task_commit_occurrences_examined": { "$ref": "#/$defs/measurement" },
        "co_change_edges_assigned": { "$ref": "#/$defs/measurement" },
        "ancestry_ancestors_visited": { "$ref": "#/$defs/measurement" },
        "ancestry_retained_entries": { "$ref": "#/$defs/measurement" }
      }
    },
    "timing_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "fixture_materialization", "restore_and_build", "process_host_startup_and_shutdown", "cli_process", "core_analysis_session", "result_publication", "total_end_to_end"],
      "properties": {
        "contract": { "const": "independent-stopwatch-intervals/v1" },
        "fixture_materialization": { "$ref": "#/$defs/measurement" },
        "restore_and_build": { "$ref": "#/$defs/measurement" },
        "process_host_startup_and_shutdown": { "$ref": "#/$defs/measurement" },
        "cli_process": { "$ref": "#/$defs/measurement" },
        "core_analysis_session": { "$ref": "#/$defs/measurement" },
        "result_publication": { "$ref": "#/$defs/measurement" },
        "total_end_to_end": { "$ref": "#/$defs/measurement" },
        "profiler_overhead": { "$ref": "#/$defs/profiler_overhead" }
      }
    },
    "profiler_overhead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrumentation", "observer_disabled_analysis", "observer_enabled_analysis", "observer_disabled_allocated_bytes", "observer_enabled_allocated_bytes", "observer_disabled_peak_retained_bytes", "observer_enabled_peak_retained_bytes", "canonical_results_match"],
      "properties": {
        "instrumentation": { "const": "benchmark-work-observer/v1" },
        "observer_disabled_analysis": { "$ref": "#/$defs/measurement" },
        "observer_enabled_analysis": { "$ref": "#/$defs/measurement" },
        "observer_disabled_allocated_bytes": { "$ref": "#/$defs/measurement" },
        "observer_enabled_allocated_bytes": { "$ref": "#/$defs/measurement" },
        "observer_disabled_peak_retained_bytes": { "$ref": "#/$defs/measurement" },
        "observer_enabled_peak_retained_bytes": { "$ref": "#/$defs/measurement" },
        "canonical_results_match": { "type": "boolean" }
      }
    },
    "canonical_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "sha256", "finding_count", "completion_status", "exit_code"],
      "properties": {
        "algorithm": { "const": "sha256-canonical-result/v1" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "finding_count": { "type": "integer", "minimum": 0 },
        "completion_status": { "type": "string" },
        "exit_code": { "type": "integer" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "operating_system", "architecture", "configuration", "source_identity", "tool_identity", "peak_working_set", "managed_allocation"],
      "properties": {
        "runtime": { "type": "string" },
        "operating_system": { "type": "string" },
        "architecture": { "type": "string" },
        "configuration": { "type": "string" },
        "source_identity": { "type": "string" },
        "tool_identity": { "type": "string" },
        "source_revision": { "type": "string", "minLength": 1 },
        "runner_identity": { "type": "string", "minLength": 1 },
        "materialized_input_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "peak_working_set": { "$ref": "#/$defs/measurement" },
        "managed_allocation": { "$ref": "#/$defs/measurement" }
      }
    },
    "complexity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scale_variable", "current_work_model", "observed_growth", "target_work_model", "disposition", "scale_points"],
      "properties": {
        "scale_variable": { "type": "string" },
        "current_work_model": { "type": "string" },
        "observed_growth": { "type": "string" },
        "target_work_model": { "type": "string" },
        "disposition": { "enum": ["candidate", "not_reproduced", "deferred", "implemented"] },
        "scale_points": { "type": "array", "items": { "type": "object" } }
      }
    },
    "expected_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_reference", "target_phase", "baseline_phase_share", "current_work_model", "target_work_model", "expected_local_speedup_small", "expected_local_speedup_medium", "expected_local_speedup_large", "expected_end_to_end_upper_bound", "memory_allocation_trade_off", "cold_path_trade_off", "success_threshold", "kill_criterion", "confidence"],
      "properties": {
        "issue_reference": { "type": "string", "pattern": "^#[0-9]+$" },
        "target_phase": { "type": "string" },
        "baseline_phase_share": { "type": "number", "minimum": 0, "maximum": 1 },
        "current_work_model": { "type": "string" },
        "target_work_model": { "type": "string" },
        "expected_local_speedup_small": { "type": "number", "exclusiveMinimum": 0 },
        "expected_local_speedup_medium": { "type": "number", "exclusiveMinimum": 0 },
        "expected_local_speedup_large": { "type": "number", "exclusiveMinimum": 0 },
        "expected_end_to_end_upper_bound": { "type": "number", "exclusiveMinimum": 0 },
        "memory_allocation_trade_off": { "type": "string" },
        "cold_path_trade_off": { "type": "string" },
        "success_threshold": { "type": "string" },
        "kill_criterion": { "type": "string" },
        "confidence": { "type": "string" }
      }
    }
  }
}
