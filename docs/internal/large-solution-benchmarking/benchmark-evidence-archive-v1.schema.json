{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archlinternet.dev/schema/benchmark-evidence-archive/v1",
  "title": "ArchLinterNet benchmark-evidence-archive/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["archive_schema_id", "encoding", "payload_sha256", "payload_base64_chunks"],
  "properties": {
    "archive_schema_id": { "const": "benchmark-evidence-archive/v1" },
    "encoding": { "const": "gzip+base64" },
    "payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "payload_base64_chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 4,
        "maxLength": 4096,
        "pattern": "^[A-Za-z0-9+/]+={0,2}$"
      }
    }
  }
}
